OPENHW_SUBSYSTEM_2
type Subsystem_kus_cruiserion_hw1_e4fa454c18
scale 1
hull @/Subsystems/kus_cruiserion/model.hod
mad -
surface 0 0 @/Subsystems/kus_cruiserion/m0
gun 0 Hull Weapon_Turret_Ion1_Position Weapon_Turret_Ion1_Latitude Weapon_Turret_Ion1_Latitude Weapon_Turret_Ion1_Muzzle
gun 1 Hull Weapon_Turret_Ion1Slave_Position Weapon_Turret_Ion1Slave_Latitude Weapon_Turret_Ion1Slave_Latitude Weapon_Turret_Ion1Slave_Muzzle

presentation Hull component_events.owevents
[Weapons]
GUN 0
//Desired Range = 6000
//ADD this amount: 690 to compensate for centrepoint
//ADD this amount:1058 to compensate for stopping distance
{
WeaponFire @/RemasteredFX/WeaponFire/kus_ionbeam.wf
