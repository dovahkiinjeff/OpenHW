BulletMass                          0.0
FireTime                            6.0
TriggerHappy                        7.0
minturnangle                       -85.0                         ; degrees
maxturnangle                        85.0
mindeclination                      -1.0
maxdeclination                      13.0
maxanglespeed                      360.0                         ; degrees/s
maxdeclinationspeed                360.0
angletracking                        1.5
declinationtracking                  1.5
BarrelLength                      82.0
OffsetX                             0.01
OffsetY                             -19
}

GUN 1
//Desired Range = 6000
//ADD this amount: 690 to compensate for centrepoint
//ADD this amount:1058 to compensate for stopping distance
{
WeaponFire @/RemasteredFX/WeaponFire/kus_ionbeam.wf
