OPENHW_SUBSYSTEM_2
type Subsystem_kus_hvcorvette1_hw1_019039add8
scale 1
hull @/Subsystems/kus_hvcorvette1/model.hod
mad -
surface 0 0 @/Subsystems/kus_hvcorvette1/m0
gun 0 Hull Weapon_Gun0_Position Weapon_Gun0_Latitude Weapon_Gun0_Latitude Weapon_Gun0_Muzzle

presentation Hull component_events.owevents
[Weapons]
GUN 0
{
WeaponFire @/RemasteredFX/WeaponFire/kinetic_small.wf

Type                             GUN_NewGimble
SoundType                        GS_MediumEnergyCannon
DamageLo                         20                         ; damage variance per shot - low
DamageHi                         31                        ; damage variance per shot - high
BulletLength                     22.0                       ; visual only.  Length of bullet on screen
BulletRange                      5000.0                     ; distance bullets travel before disappearing; also defines the range of the gun
BulletSpeed                      15000.0                     ; measured in m/s.
BulletMass                       0.01                        ; mass of bullet
FireTime                         2.7                        ; fire repeat rate (reciprocal = shots/second)
TriggerHappy                     7.0
minturnangle                   -30.0                          ; degrees
maxturnangle                    30.0
mindeclination                 -30.0
maxdeclination                  30.0
maxanglespeed                  360.0                          ; degrees/s
maxdeclinationspeed            360.0
angletracking                    4.0
declinationtracking              4.0
BarrelLength                    10.5
RecoilLength                     6.0
}
[End]
