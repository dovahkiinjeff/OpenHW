SoundType                           GS_LargeEnergyCannon
DamageLo                            40
DamageHi                            45
BulletLength                        18.0
BulletRange                         5606.0
BulletSpeed                         4300.0
BulletMass                          0.75
FireTime                            2.9
TriggerHappy                       10.0
minturnangle                     -110.0                      ; degrees
maxturnangle                       10.0
mindeclination                    -10.0
maxdeclination                     90.0
maxanglespeed                     360.0                        ; degrees/s
maxdeclinationspeed               360.0
angletracking                       2.5
declinationtracking                 2.5
BarrelLength                       47.0                        ; was 70m
RecoilLength                       12.5
}
