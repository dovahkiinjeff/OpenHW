OPENHW_SUBSYSTEM_2
type Subsystem_tai_assaultcannon_hw1_774cabf2d8
scale 1
hull @/Subsystems/tai_assaultcannon/model.hod
mad -
surface 0 0 @/Subsystems/tai_assaultcannon/m0
gun 0 Hull Weapon_Gun1_Position Weapon_Gun1_Latitude Weapon_Gun1_Latitude Weapon_Gun1_Muzzle

presentation Hull component_events.owevents
[Weapons]
GUN 0
//Desired Range = 4800
//ADD this amount:  22 to compensate for centrepoint
//ADD this amount: 784 to compensate for stopping distance
{
WeaponFire @/RemasteredFX/WeaponFire/hw1kinetic_small.wf

