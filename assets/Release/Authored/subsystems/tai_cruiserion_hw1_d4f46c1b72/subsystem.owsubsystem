OPENHW_SUBSYSTEM_2
type Subsystem_tai_cruiserion_hw1_d4f46c1b72
scale 1
hull @/Subsystems/tai_cruiserion/model.hod
mad -
surface 0 0 @/Subsystems/tai_cruiserion/m0
gun 0 Hull - - - Weapon_Ion1_Muzzle
gun 1 Hull Weapon_Ion1_Position Weapon_Ion1_Latitude Weapon_Ion1_Latitude Weapon_Ion1_Muzzle

