[Unit]
Description=Mirror verified OpenHW release downloads and feed
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=openhw-game
Group=openhw-game
WorkingDirectory=/srv/openhw-game/app
ExecStart=/usr/bin/python3 /srv/openhw-game/app/mirror_updates.py
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/openhw-downloads
MemoryMax=256M
TimeoutStartSec=1800
UMask=0022
